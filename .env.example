APP_NAME=GoCarMats
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gocarmats
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Internal Security Gate
SETTINGS_ACCESS_PASSWORD=Securepassword11@@

# Python DXF Converter API
PYTHON_API_BASE_URL=http://localhost:8000
PYTHON_API_UPLOAD_DIR=dxf_uploads
PYTHON_API_CONVERTED_DIR=dxf_converted
PYTHON_API_TIMEOUT=30
PYTHON_API_RETRY_ATTEMPTS=3
PYTHON_API_RETRY_DELAY=1000
PYTHON_BOT_BASE_URL=http://127.0.0.1:5000/

# Evri Shipping Integration
EVRI_API_KEY=
EVRI_SECRET=
EVRI_LABEL_URL=https://www.hermes-europe.co.uk/routing/service/rest/v4/routeDeliveryCreatePreadviceAndLabel
EVRI_TRACKING_ENDPOINTS="https://www.hermes-europe.co.uk/routing/service/rest/v4/routeDeliveryTrackParcel,https://www.hermes-europe.co.uk/routing/service/rest/v4/getParcelDeliveryStatus"
EVRI_PUBLIC_TRACKING_URL=
EVRI_VERIFICATION_BATCH_LIMIT=100
EVRI_VERIFICATION_RECHECK_HOURS=6

# Amazon SP-API Integration
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SHIPPING_BUSINESS_ID=AmazonShipping_UK
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# Shipmate Integration
SHIPMATE_API_KEY=
SHIPMATE_TOKEN=
SHIPMATE_BASE_URL=https://api.shipmate.co.uk/v1.2
SHIPMATE_DELIVERY_SERVICE_KEY=
SHIPMATE_CUSTOMS_COUNTRY_OF_ORIGIN=GB
SHIPMATE_CUSTOMS_SHORT_DESC="Car Mats"
SHIPMATE_CUSTOMS_FULL_DESC="Automotive Car Mats"
SHIPMATE_CUSTOMS_HARMONISED_CODE=87089900
SHIPMATE_CUSTOMS_INCOTERMS=DAP
SHIPMATE_CUSTOMS_REASON=SALE

# ShipStation Integration
SHIPSTATION_ENABLED=false
SHIPSTATION_CLIENT_SECRET_ID=
SHIPSTATION_CLIENT_SECRET=
SHIPSTATION_PRIME_ORDER_TAG_ID=

# Veeqo Integration
VEEQO_API_KEY=
VEEQO_BASE_URL=https://api.veeqo.com

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=120
OPENAI_IMAGE_DETAIL=high
